# Build output
/bin/
/out/
*.exe

# Test and coverage artefacts
*.test
coverage.out
coverage.html

# Local overrides
configs/config.local.yaml
.env
.env.*
# The template holds no secrets and is what .env is copied from.
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Python (offline ML work under ml/)
__pycache__/
*.py[cod]
ml/.venv/
.pytest_cache/

# Snapshot payloads are derived from third-party article text collected for
# study. The manifest and data card describe them; the text itself is never
# redistributed. Regenerate with `make ml-snapshot`.
ml/data/snapshots/*/*.jsonl

# Labelling sheets carry article titles and summaries, so they stay local too.
# The completed gold set (ml/data/labels/gold.jsonl) is ids and labels only and
# is committed, because every reported metric depends on it.
ml/data/labels/*/

# The near-duplicate sheet quotes two articles per row, for the same reason. Its
# key is ids and scores only, so that one is committed: without it a returned
# sheet cannot be joined back to anything.
ml/data/pairs/pairs.csv

# The fitted model is an 11 MB binary that `make ml-train` reproduces from the
# snapshot id in its own manifest. The manifest and model card sit beside it and
# are committed, because they are what makes a prediction traceable.
ml/artifacts/models/*/*.joblib
