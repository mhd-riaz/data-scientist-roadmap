# Build output
/bin/
/out/
*.exe

# Test and coverage artefacts
*.test
coverage.out
coverage.html

# Local overrides
configs/config.local.yaml
.env
.env.*
# The template holds no secrets and is what .env is copied from.
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Python (offline ML work under ml/)
__pycache__/
*.py[cod]
ml/.venv/
.pytest_cache/

# Snapshot payloads are derived from third-party article text collected for
# study. The manifest and data card describe them; the text itself is never
# redistributed. Regenerate with `make ml-snapshot`.
ml/data/snapshots/*/*.jsonl
