# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Values already present in the real environment win over this file, so the same
# binary reads secrets from here on a laptop and from Coolify's injected
# environment in the homelab.

# --- API authentication -----------------------------------------------------
# A request is accepted if it presents EITHER a known API key in the custom
# header OR valid basic credentials. Configure at least one.

NEWS_AUTH_ENABLED=true
NEWS_AUTH_API_KEY_HEADER=X-API-Key

# Comma-separated, minimum 32 characters each. Generate one with:
#   openssl rand -hex 32
# Keep the old key alongside the new one while clients migrate, then drop it.
NEWS_AUTH_API_KEYS=

# Minimum 16 characters. Leave both blank to run with API keys only.
NEWS_AUTH_BASIC_USERNAME=
NEWS_AUTH_BASIC_PASSWORD=

# --- Database ---------------------------------------------------------------
# Credentials embedded here are redacted before the URI is logged.
NEWS_MONGO_URI=mongodb://localhost:27017
NEWS_MONGO_DATABASE=news

# --- Runtime ----------------------------------------------------------------
NEWS_APP_ENVIRONMENT=development
NEWS_LOGGING_LEVEL=info
NEWS_LOGGING_FORMAT=json
